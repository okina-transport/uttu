    <name>uttu</name>
    <description>Backend for Flexible Transport Editor</description>

    <properties>

        <entur.google.pubsub.emulator.download.skip>true</entur.google.pubsub.emulator.download.skip>

        <!-- versions for use in mvn plugins as we cannot inherit them from a BOM -->
        <okina.helpers.version>1.0.24-SNAPSHOT</okina.helpers.version>

        <postgis-jdbc.version>2.3.0</postgis-jdbc.version>
        <geodb.version>0.9</geodb.version>
        <geotools.version>20.1</geotools.version>
        <wololo.version>0.13.0</wololo.version>

        <swagger-jersey2.version>1.6.2</swagger-jersey2.version>
        <javax.jdo.jdo2-api.version>2.3-eb</javax.jdo.jdo2-api.version>

        <commons-io.version>2.7</commons-io.version>

        <groovy-all.version>2.5.8</groovy-all.version>
        <rest-assured.version>5.5.6</rest-assured.version>
        <graphql.version>25.0</graphql.version>
        <netex-java-model.version>2.0.6-NETEX-FR</netex-java-model.version>
        <guava.version>28.1-jre</guava.version>
        <resteasy.version>7.0.0.Final</resteasy.version>
        <postgresql.version>42.7.8</postgresql.version>
